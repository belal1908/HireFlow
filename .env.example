# Copy this file to .env and fill in real values for local development.
# .env is git-ignored; never commit real secrets.

# --- Database (used by docker-compose.yml and application.yml) ---
# Host port 5433 (not the default 5432) to avoid colliding with any other local Postgres.
DB_HOST_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/hireflow
DB_USERNAME=hireflow
DB_PASSWORD=hireflow

# --- JWT ---
# Must be a Base64 (or plain, >= 32 char) secret used to sign HS256 access/refresh tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-value-before-running-outside-your-laptop
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Server ---
SERVER_PORT=8080

# --- Full-stack Docker Compose only (the "full" profile: `docker compose --profile full up`) ---
# Host ports the containerized backend/frontend publish to. Not used by local `mvn spring-boot:run`
# / `ng serve` dev (those use SERVER_PORT and Angular's dev server directly).
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=4200

# --- Admin bootstrap (optional) ---
# Self-registration always creates a CANDIDATE, and creating a RECRUITER/ADMIN account normally
# requires an existing ADMIN - so there's no path to the *first* admin without one of these.
# Leave both unset to skip this and promote the first admin by hand in Postgres instead
# (`UPDATE users SET role = 'ADMIN' WHERE email = '...';`). Set both to seed one admin account on
# startup - only runs once, only if no ADMIN exists yet, never overwrites an existing admin.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-this-before-running-outside-your-laptop
