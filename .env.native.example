# Alternative to .env.example for day-to-day dev WITHOUT Docker/Colima running.
#
# Points at a native Postgres (Homebrew, port 5432) instead of the Colima-hosted container on
# 5433. This exists because Colima idles at meaningful CPU/memory even when nothing is using it,
# and starting/stopping it for every dev session is friction that isn't necessary for the parts
# of the workflow that don't actually need a container runtime - see the README's "Running
# without Docker/Colima" section for exactly which commands do and don't need it.
#
# Setup (one-time): create the role/database in your native Postgres before using this file:
#   psql -d postgres -c "CREATE ROLE hireflow LOGIN PASSWORD 'hireflow';"
#   createdb -O hireflow hireflow
#
# Usage: cp .env.native.example .env  (instead of .env.example), when you want to work without
# starting Colima. Switch back to .env.example's DB_URL/DB_HOST_PORT before running anything that
# does need Docker (mvn test, docker compose --profile full).

# --- Database (native Homebrew Postgres, default port 5432 — no Docker needed) ---
DB_URL=jdbc:postgresql://localhost:5432/hireflow
DB_USERNAME=hireflow
DB_PASSWORD=hireflow

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-secret-value-before-running-outside-your-laptop
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Server ---
SERVER_PORT=8080
